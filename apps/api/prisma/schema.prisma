generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Impressora {
  A1
  H2C
}

enum Canal {
  SHOPEE
  ML
  SITE
  TIKTOK
}

enum VendedorShopeeTipo {
  CNPJ
  CPF_BAIXO
  CPF_ALTO
}

enum Origem {
  ML
  SHOPEE
  SITE
  ESTOQUE
}

enum JobStatus {
  FILA
  IMPRIMINDO
  CONCLUIDO
  EMBALADO
  ENVIADO
  CANCELADO
}

enum OrigemImagem {
  INSPIRACAO
  MODELO_3D
  GERADA
  OUTRA
}

/// Método planejado pra gerar a foto final do produto.
/// IA = gerar via skill /gerar-imagem (Nano Banana Pro). FOTO = imprimir + fotografar.
/// null = ainda não decidido. Usado pra filtrar filas de trabalho distintas.
enum MetodoImagem {
  IA
  FOTO
}

enum CategoriaCusto {
  ALUGUEL
  ENERGIA
  INTERNET
  SOFTWARE
  ASSINATURA
  MARKETING
  INSUMOS
  IMPOSTOS
  OUTROS
}

enum SyncOrigem {
  MANUAL
  CRON
}

enum OportunidadeMarketplace {
  SHOPEE
  TIKTOK
  ML
  OUTRO
}

enum OportunidadeFonte {
  CONCORRENTE
  KEYWORD
  CATEGORIA
  TOP_VENDAS
  // Ideia autoral da Mahou inspirada em produtos do marketplace.
  // externalId é um cuid local (não Shopee item). Notas guardam inspirações + análise.
  IDEIA_GERADA
}

enum OportunidadeStatus {
  NOVO
  EM_ANALISE
  APROVADO
  DESCARTADO
  VIRARAM_PRODUTO
}

enum TipoItemEstoque {
  PRODUTO
  FILAMENTO
  INSUMO
}

enum MotivoMovimento {
  ESTOQUE_INICIAL
  COMPRA
  PRODUCAO
  VENDA
  AJUSTE
  PERDA
}

/// ADMIN = acesso total. VISUALIZADOR = somente leitura (bloqueado em qualquer mutação).
enum Papel {
  ADMIN
  VISUALIZADOR
}

model Usuario {
  id        String   @id @default(cuid())
  /// Opcional: usuários internos (ex.: visualizador) podem logar só por `login`.
  email     String?  @unique
  /// Username alternativo pro login (ex.: "roniberger"). O admin loga pelo e-mail.
  login     String?  @unique
  nome      String?
  senhaHash String
  papel     Papel    @default(ADMIN)
  criadoEm  DateTime @default(now())
}

model Filamento {
  id               String             @id @default(cuid())
  nome             String             @unique
  custoKgCentavos  Int
  potenciaA1W      Int
  potenciaH2cW     Int
  /// Sigla de 2-3 letras que representa esta cor no SKU (AZ, VM, VD, PT, BR, RS).
  /// Fica no filamento, e não solta em cada variação, pra "azul" não virar AZ num produto
  /// e AZUL noutro — SKU inconsistente é SKU que ninguém confia.
  siglaCor         String?
  observacao       String?
  ativo            Boolean            @default(true)
  // Estoque do rolo em gramas; baixa automática quando um job de produção é confirmado.
  estoqueGramas    Decimal            @default(0) @db.Decimal(10, 2)
  // Alerta de reposição: avisa quando estoqueGramas <= estoqueMinGramas.
  estoqueMinGramas Decimal            @default(0) @db.Decimal(10, 2)
  produtos         Produto[]
  variacoes        ProdutoVariacao[]
  movimentos       MovimentoEstoque[]
  itensRecibo      ReciboItem[]
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt
}

model Produto {
  id                String                @id @default(cuid())
  nome              String
  inspiracao        String?
  modelo3dUrl       String?
  larguraCm         Decimal?              @db.Decimal(6, 1)
  alturaCm          Decimal?              @db.Decimal(6, 1)
  profundidadeCm    Decimal?              @db.Decimal(6, 1)
  filamentoId       String
  filamento         Filamento             @relation(fields: [filamentoId], references: [id])
  pesoG             Decimal               @db.Decimal(10, 2)
  tempoH            Decimal               @db.Decimal(10, 2)
  impressora        Impressora
  embalagemCentavos Int
  precoCentavos     Int
  canalPrincipal    Canal
  ativo             Boolean               @default(true)
  /// Indica se o produto já foi publicado em ALGUM marketplace.
  /// Fluxo externo de geração de imagem só processa produtos com anunciado=false, então
  /// o campo continua existindo — é mantido em sincronia com `canaisAnunciados`:
  /// verdadeiro quando a lista tem pelo menos um canal.
  anunciado         Boolean               @default(false)
  /// ONDE o produto está anunciado. Vazio = em lugar nenhum.
  ///
  /// Anunciar é canal a canal na vida real: sai na Shopee hoje, no ML semana que vem, e
  /// às vezes se tira de um só. Um booleano único não conseguia responder "falta publicar
  /// onde?", que é a pergunta que decide o próximo trabalho.
  canaisAnunciados  Canal[]
  /// Faz parte do catálogo ATUAL — é o que a Vitrine lista.
  ///
  /// Separado de `anunciado` de propósito. Os 53 produtos herdados são da loja antiga
  /// e vários estão com `anunciado=true`; virá-los pra false pra limpar a Vitrine
  /// jogaria todos eles de volta na fila do fluxo externo de imagem, que filtra
  /// justamente por `anunciado=false`. Marcador próprio evita esse efeito colateral.
  naVitrine         Boolean               @default(false)
  /// Produto incompleto (criado a partir de Oportunidade sem preencher tudo).
  /// Quando true: alguns campos podem estar zerados (peso/tempo) e ativo=false.
  /// Usuário precisa completar antes de anunciar.
  rascunho          Boolean               @default(false)
  /// IA = gerar via skill. FOTO = imprimir+fotografar. null = ainda não decidido.
  /// Fluxos da skill /gerar-imagem só pegam metodoImagem=IA + imagens upadas.
  metodoImagem      MetodoImagem?
  jobs              JobProducao[]
  vendas            Venda[]
  insumos           ProdutoInsumo[]
  imagens           ProdutoImagem[]
  oportunidades     ProdutoOportunidade[]
  modeloMakerWorld  ModeloMakerWorld?
  variacoes         ProdutoVariacao[]
  criadoEm          DateTime              @default(now())
  atualizadoEm      DateTime              @updatedAt
}

/// Insumo reutilizável usado em vários produtos (caixa, fita, etiqueta).
/// Soft-delete via ativo=false — produtos antigos referenciam insumos antigos.
model Insumo {
  id                    String             @id @default(cuid())
  nome                  String             @unique
  unidade               String // texto livre: "un", "m", "kg", "ml"
  custoUnitarioCentavos Int
  observacao            String?
  ativo                 Boolean            @default(true)
  // Estoque na unidade do campo `unidade` (frações: 1.5 m de fita, 0.25 kg).
  estoqueAtual          Decimal            @default(0) @db.Decimal(10, 3)
  estoqueMinimo         Decimal            @default(0) @db.Decimal(10, 3)
  produtos              ProdutoInsumo[]
  movimentos            MovimentoEstoque[]
  itensRecibo           ReciboItem[]
  criadoEm              DateTime           @default(now())
  atualizadoEm          DateTime           @updatedAt
}

/// Pivot Produto↔Insumo com quantidade consumida por unidade de produto.
/// qtd em Decimal(10,3) cobre frações: 0.5m de fita, 0.125kg de papel etc.
model ProdutoInsumo {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo  @relation(fields: [insumoId], references: [id])
  qtd       Decimal @db.Decimal(10, 3)

  @@unique([produtoId, insumoId])
}

/// Imagem de referência do produto (inspiração, modelo 3D, foto manual ou gerada).
/// `arquivo` é path relativo a STORAGE_DIR: "<produtoId>/<imagemId>.jpg".
/// Sharp normaliza tudo pra JPG max 2000px na hora do upload — original não fica.
model ProdutoImagem {
  id        String       @id @default(cuid())
  produtoId String
  produto   Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  arquivo   String
  origem    OrigemImagem @default(OUTRA)
  ordem     Int          @default(0)
  larguraPx Int?
  alturaPx  Int?
  bytes     Int?
  criadoEm  DateTime     @default(now())

  @@index([produtoId])
}

model Venda {
  id                    String           @id @default(cuid())
  produtoId             String
  produto               Produto          @relation(fields: [produtoId], references: [id])
  /// Qual cor/versão saiu. Nulo nas vendas lançadas à mão antes disso existir e nas de
  /// produto sem variação — é o que permite responder "vendi 12 azuis e 3 rosas".
  variacaoId            String?
  variacao              ProdutoVariacao? @relation(fields: [variacaoId], references: [id])
  /// Item de pedido que gerou esta venda. Unique: reimportar o mesmo pedido (o que
  /// acontece a cada mudança de status) não pode faturar duas vezes. Nulo = venda que o
  /// Gabriel lançou na mão.
  pedidoItemId          String?          @unique
  pedidoItem            PedidoItem?      @relation(fields: [pedidoItemId], references: [id], onDelete: SetNull)
  qtd                   Int
  precoUnitarioCentavos Int // pode diferir de Produto.precoCentavos
  canal                 Canal
  dataVenda             DateTime
  observacao            String?
  criadoEm              DateTime         @default(now())

  @@index([dataVenda])
  @@index([canal])
  @@index([variacaoId])
}

/// Custo geral da Mahou Prints (aluguel, internet, software, etc).
/// `dataCompetencia` é sempre dia 1 do mês — agrupa por mês competência.
/// `recorrente=true` gera 12 cópias futuras na criação (com geradoAutomatico=true).
model Custo {
  id               String         @id @default(cuid())
  descricao        String
  categoria        CategoriaCusto
  valorCentavos    Int
  dataCompetencia  DateTime
  recorrente       Boolean        @default(false)
  geradoAutomatico Boolean        @default(false)
  observacao       String?
  criadoEm         DateTime       @default(now())

  @@index([dataCompetencia])
  @@index([categoria])
}

/// Singleton: sempre id=1. Configurações globais do Hub.
model Parametro {
  id                            Int                @id @default(1)
  tarifaKwhCentavos             Int
  vendedorShopee                VendedorShopeeTipo
  emCampanhaShopee              Boolean            @default(false)
  adicionalCampanhaPct          Decimal            @db.Decimal(5, 2)
  comissaoMlPct                 Decimal            @db.Decimal(5, 2)
  impostoAtivo                  Boolean            @default(false)
  impostoPct                    Decimal            @db.Decimal(5, 2)
  // Taxas do TikTok Shop são percentuais simples (sem faixa por preço).
  // Defaults batem com a estrutura padrão (jul/2026): comissão+SFP+afiliado+pagamento.
  tiktokComissaoPlataformaPct   Decimal            @default(6.00) @db.Decimal(5, 2)
  tiktokTaxaSfpPct              Decimal            @default(6.00) @db.Decimal(5, 2)
  tiktokComissaoAfiliadoPct     Decimal            @default(30.00) @db.Decimal(5, 2)
  tiktokTaxaPagamentoPct        Decimal            @default(3.00) @db.Decimal(5, 2)
  margemThresholdVerde          Decimal            @default(0.30) @db.Decimal(4, 3)
  margemThresholdAmarelo        Decimal            @default(0.15) @db.Decimal(4, 3)
  // Defaults globais do plano de anúncios (Shopee Ads), tunáveis pelo usuário.
  // A Calculadora permite override local sem persistir. Lógica em @mahou-hub/pricing planoAds.
  adsCpcMedioCentavos           Int                @default(50)
  adsTaxaRetornoPct             Decimal            @default(8.00) @db.Decimal(5, 2)
  adsJanelaTesteDias            Int                @default(5)
  adsNivelConfianca             Int                @default(95)
  adsFatorMargemEscala          Decimal            @default(1.40) @db.Decimal(4, 2)
  adsPassoIncrementoPct         Decimal            @default(25.00) @db.Decimal(5, 2)
  adsCadenciaIncrementoDias     Int                @default(3)
  adsNDegraus                   Int                @default(5)
  adsBudgetDiarioMinimoCentavos Int?
  adsTetoBudgetDiarioCentavos   Int?
  atualizadoEm                  DateTime           @updatedAt
}

model TaxaShopee {
  id                   String  @id @default(cuid())
  limInferiorCentavos  Int     @unique
  comissaoPct          Decimal @db.Decimal(5, 2)
  fixaCnpjCentavos     Int
  fixaCpfBaixoCentavos Int
  fixaCpfAltoCentavos  Int
}

model TaxaMercadoLivre {
  id                   String  @id @default(cuid())
  faixa                String  @unique // A..E
  limInferiorCentavos  Int
  custoFixoCentavos    Int
  pctAlternativo       Decimal @db.Decimal(5, 2)
  comissaoCategoriaPct Decimal @db.Decimal(5, 2)
}

/// Concorrente monitorado. Pode ser puramente manual (campos antigos: loja/instagram/website)
/// ou linkado a uma loja Shopee via shopId — nesse caso os campos shopee* são preenchidos
/// pelo último sync e o histórico de snapshots fica em ConcorrenteSnapshot.
model Concorrente {
  id                   String                @id @default(cuid())
  loja                 String
  instagram            String?
  website              String?
  observacao           String?
  // Campos opcionais quando a loja é Shopee (rastreio via API de afiliados).
  shopId               BigInt?               @unique
  username             String?
  urlOriginal          String?
  imageUrl             String?
  ratingStar           Decimal?              @db.Decimal(3, 2)
  commissionRatePadrao Decimal?              @db.Decimal(5, 4)
  sellerCommCoveRatio  Decimal?              @db.Decimal(5, 4)
  ultimoSyncEm         DateTime?
  precos               PrecoConcorrente[]
  snapshots            ConcorrenteSnapshot[]
  oportunidades        ProdutoOportunidade[]
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
}

model PrecoConcorrente {
  id             String      @id @default(cuid())
  concorrenteId  String
  concorrente    Concorrente @relation(fields: [concorrenteId], references: [id], onDelete: Cascade)
  produtoSimilar String
  precoCentavos  Int
  capturadoEm    DateTime    @default(now())
  fonteUrl       String?
}

/// Snapshot de um sync da Shopee (manual ou cron). Cada execução cria uma nova linha
/// e os produtos retornados vão pra ConcorrenteSnapshotProduto vinculados a ela.
/// Sync com erro grava erroMensagem e qtdProdutos=0.
model ConcorrenteSnapshot {
  id             String                       @id @default(cuid())
  concorrenteId  String
  concorrente    Concorrente                  @relation(fields: [concorrenteId], references: [id], onDelete: Cascade)
  sincronizadoEm DateTime                     @default(now())
  origem         SyncOrigem
  qtdProdutos    Int                          @default(0)
  erroMensagem   String?
  produtos       ConcorrenteSnapshotProduto[]
  criadoEm       DateTime                     @default(now())

  @@index([concorrenteId, sincronizadoEm(sort: Desc)])
}

/// Produto retornado pela Shopee Affiliate naquele sync. Cópia imutável dos campos
/// expostos pela API (19 campos confirmados). Pra ver "estado atual" basta o último snapshot.
model ConcorrenteSnapshotProduto {
  id                 String                @id @default(cuid())
  snapshotId         String
  snapshot           ConcorrenteSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  itemId             BigInt
  productName        String
  priceMinCentavos   Int
  priceMaxCentavos   Int
  priceDiscountRate  Int
  /// `sales` cru da Shopee Affiliate API — período da campanha, NÃO histórico total.
  sales              Int
  /// Vendas totais reais (enriquecimento manual via Seller Center, opcional). Null = ainda não preenchido.
  vendasReais        Int?
  commissionRate     Decimal               @db.Decimal(5, 4)
  commissionCentavos Int
  imageUrl           String
  productLink        String
  offerLink          String
  productCatIds      Int[]
  shopType           Int[]
  ratingStar         Decimal?              @db.Decimal(3, 2)
  periodStartTime    DateTime
  periodEndTime      DateTime
  oportunidades      ProdutoOportunidade[]

  @@index([snapshotId, itemId])
}

/// Candidato a virar produto na Mahou. Materializado a partir de busca/varredura
/// em marketplaces (Shopee hoje; TikTok/ML no futuro via provider pattern).
/// Dedup por (marketplace, externalId) — mesma oportunidade é upsertada com dados frescos.
model ProdutoOportunidade {
  id String @id @default(cuid())

  marketplace OportunidadeMarketplace
  /// itemId Shopee, productId TikTok etc. String pra acomodar BigInt/UUID/etc.
  externalId  String

  productName       String
  priceMinCentavos  Int
  priceMaxCentavos  Int
  imageUrl          String
  productLink       String
  /// `sales` da Shopee Affiliate normalizado pra base mensal — NÃO histórico total. Antes inflava com 1/0.05; agora é só sales do afiliado projetado pra 30 dias.
  vendasAfiliadoMes Int
  /// Vendas totais reais (enriquecimento manual via Seller Center, opcional). Null = ainda não preenchido.
  vendasReais       Int?
  ratingStar        Decimal? @db.Decimal(3, 2)
  /// IDs de categoria no marketplace (genérico — Shopee usa productCatIds).
  categoriaIds      Int[]
  lojaExternalId    String?
  lojaNome          String?

  fonte             OportunidadeFonte
  /// keyword, catId ou outro parâmetro que originou a oportunidade.
  fonteParam        String?
  concorrenteId     String?
  concorrente       Concorrente?                @relation(fields: [concorrenteId], references: [id], onDelete: SetNull)
  snapshotProdutoId String?
  snapshotProduto   ConcorrenteSnapshotProduto? @relation(fields: [snapshotProdutoId], references: [id], onDelete: SetNull)

  status    OportunidadeStatus @default(NOVO)
  /// 0..100, definido por Claude/manual após avaliação.
  score     Decimal?           @db.Decimal(5, 2)
  /// Análise livre (Claude preenche com justificativa estruturada).
  notas     String?
  produtoId String?            @unique
  produto   Produto?           @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  logs         OportunidadeLog[]

  @@unique([marketplace, externalId])
  @@index([status, score(sort: Desc)])
  @@index([criadoEm(sort: Desc)])
}

enum OportunidadeLogAcao {
  CREATED
  STATUS_CHANGE
  SCORE_CHANGE
  NOTAS_CHANGE
  VIRARAM_PRODUTO
}

/// Audit trail das mudanças em ProdutoOportunidade. Append-only.
/// `detalhes` é JSON com payload da mudança (status: { de, para }, score: { de, para }, etc.).
/// `usuarioId` é null pra mudanças vindas do cron/sistema.
model OportunidadeLog {
  id             String              @id @default(cuid())
  oportunidadeId String
  oportunidade   ProdutoOportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  acao           OportunidadeLogAcao
  detalhes       Json
  usuarioId      String?
  criadoEm       DateTime            @default(now())

  @@index([oportunidadeId, criadoEm(sort: Desc)])
}

model JobProducao {
  id                       String           @id @default(cuid())
  dataInicio               DateTime
  dataFim                  DateTime?
  origem                   Origem
  produtoId                String
  produto                  Produto          @relation(fields: [produtoId], references: [id])
  /// Variação (cor) opcional. Quando setada, a baixa de filamento usa o filamento da variação.
  variacaoId               String?
  variacao                 ProdutoVariacao? @relation(fields: [variacaoId], references: [id])
  qtd                      Int
  prioridade               Int              @default(0)
  impressora               Impressora
  status                   JobStatus        @default(FILA)
  /// true após a baixa automática de filamento ter sido registrada (evita baixa dupla).
  consumoRegistrado        Boolean          @default(false)
  /// true = card atendido pelo ESTOQUE DE PEÇAS PRONTAS: pula impressão, NÃO baixa filamento e
  /// baixa o estoque de prontos ao Embalar. Ortogonal a `origem` (canal do pedido, que pode ser ESTOQUE).
  daEstoque                Boolean          @default(false)
  /// true após a baixa do estoque de prontos ter sido registrada (no Embalado). Evita baixa dupla.
  consumoProdutoRegistrado Boolean          @default(false)
  anuncioCriado            Boolean          @default(false)
  anunciado                Boolean          @default(false)
  itensPedido              PedidoItem[]
  observacao               String?
  criadoEm                 DateTime         @default(now())
  atualizadoEm             DateTime         @updatedAt

  @@index([status])
  @@index([dataInicio])
  @@index([variacaoId])
}

/// Variação vendável de um Produto (ex.: cor). Cada variação tem SKU próprio,
/// pode sobrescrever filamento (cor) e preço, e carrega o estoque de peças prontas.
/// SKU é a chave que casa o item do pedido do marketplace com a variação certa.
model ProdutoVariacao {
  id            String             @id @default(cuid())
  produtoId     String
  produto       Produto            @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome          String
  sku           String             @unique
  // Overrides opcionais — quando null, herda do Produto.
  filamentoId   String?
  filamento     Filamento?         @relation(fields: [filamentoId], references: [id])
  precoCentavos Int?
  /// Peso e tempo próprios existem para a variação que muda o QUE SAI DA IMPRESSORA, não
  /// só a aparência: kit de 3 peças, tamanho G. Sem eles, um "Kit 3" descontaria do rolo o
  /// filamento de uma peça só — o estoque mentiria e o custo do kit sairia pela terça
  /// parte. Cor não precisa: mesmo molde, mesmo peso, mesmo tempo.
  pesoG         Decimal?           @db.Decimal(10, 2)
  tempoH        Decimal?           @db.Decimal(10, 2)
  // Estoque de peças prontas (unidades inteiras).
  estoqueAtual  Int                @default(0)
  estoqueMinimo Int                @default(0)
  ativo         Boolean            @default(true)
  movimentos    MovimentoEstoque[]
  jobs          JobProducao[]
  itensPedido   PedidoItem[]
  vendas        Venda[]
  criadoEm      DateTime           @default(now())
  atualizadoEm  DateTime           @updatedAt

  @@index([produtoId])
}

/// Lançamento no histórico de estoque (append-only). `quantidade` é com sinal:
/// positivo = entrada, negativo = saída. `saldoApos` guarda o saldo do item após
/// o lançamento (auditoria). Exatamente um dos três FKs é preenchido, conforme `tipoItem`.
model MovimentoEstoque {
  id                String           @id @default(cuid())
  tipoItem          TipoItemEstoque
  variacaoId        String?
  variacao          ProdutoVariacao? @relation(fields: [variacaoId], references: [id], onDelete: Cascade)
  filamentoId       String?
  filamento         Filamento?       @relation(fields: [filamentoId], references: [id])
  insumoId          String?
  insumo            Insumo?          @relation(fields: [insumoId], references: [id])
  quantidade        Decimal          @db.Decimal(12, 3)
  saldoApos         Decimal          @db.Decimal(12, 3)
  motivo            MotivoMovimento
  custoUnitCentavos Int?
  observacao        String?
  /// Recibo que originou a entrada, quando veio de nota escaneada. Dá ao histórico do
  /// estoque um vínculo de verdade em vez de só o texto da observação — dá pra abrir a
  /// nota e conferir de onde o saldo veio.
  reciboId          String?
  recibo            Recibo?          @relation(fields: [reciboId], references: [id], onDelete: SetNull)
  criadoEm          DateTime         @default(now())

  @@index([tipoItem, criadoEm(sort: Desc)])
  @@index([reciboId])
  @@index([variacaoId])
  @@index([filamentoId])
  @@index([insumoId])
}

/// PENDENTE = nota anexada, ninguém leu ainda. EXTRAIDO = a IA leu, esperando o Gabriel
/// revisar. CONFIRMADO = revisado e aplicado (estoque + custos), não mexe mais.
///
/// Não existe estado "incompleto": o que faltou está em `camposIlegiveis`, e derivar dele
/// evita dois lugares dizendo a mesma coisa e discordando.
enum ReciboStatus {
  PENDENTE
  EXTRAIDO
  CONFIRMADO
}

/// FILAMENTO e INSUMO entram no estoque e NÃO viram `Custo` — o filamento já é descontado
/// como custo variável quando a peça é vendida, e lançar a compra também deixaria o lucro
/// líquido descontando duas vezes (financeiro.service soma `Custo` do mês por cima).
/// NAO_ESTOCAVEL (frete, ferramenta, manutenção) é o contrário: só vira `Custo`.
enum ReciboItemTipo {
  FILAMENTO
  INSUMO
  NAO_ESTOCAVEL
}

/// Recibo / nota de compra. Metadados + arquivos anexados (foto ou PDF).
model Recibo {
  id            String          @id @default(cuid())
  data          DateTime
  fornecedor    String?
  valorCentavos Int?
  observacao    String?
  status        ReciboStatus    @default(PENDENTE)
  extraidoEm    DateTime?
  confirmadoEm  DateTime?
  /// Chave de acesso da NF-e: 44 dígitos, única no país inteiro. É o que impede a mesma
  /// nota de entrar duas vezes. Nulo em recibo que não é nota eletrônica (cupom, recibo
  /// de papel) — aí a identidade cai pro par numeroNota + cnpjEmitente.
  chaveNfe      String?
  numeroNota    String?
  cnpjEmitente  String?
  /// Preenchido quando a leitura reconhece a nota como já lançada. Guarda o id do recibo
  /// original pra tela poder mostrar "essa nota já entrou aqui".
  duplicataDeReciboId String?
  /// Campos da NOTA (não dos itens) que a IA não conseguiu ler com certeza: "data",
  /// "fornecedor", "valorTotal". Lista não-vazia = a UI pede outra foto.
  camposIlegiveis String[]
  arquivos      ReciboArquivo[]
  itens         ReciboItem[]
  movimentos    MovimentoEstoque[]
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  @@index([data(sort: Desc)])
  @@index([status])
  @@index([chaveNfe])
  @@index([numeroNota, cnpjEmitente])
}

/// Linha da nota, como a IA leu. Fica separada do movimento de estoque de propósito: aqui
/// é o que estava ESCRITO no papel (auditável contra a foto), lá é o que entrou no saldo.
///
/// `filamentoId`/`insumoId` nulos com tipo preenchido = item que não existe no cadastro
/// ainda; a UI oferece cadastrar.
model ReciboItem {
  id            String          @id @default(cuid())
  reciboId      String
  recibo        Recibo          @relation(fields: [reciboId], references: [id], onDelete: Cascade)
  /// Texto do item exatamente como aparece na nota, sem normalizar — é o que permite
  /// conferir a leitura contra a foto depois.
  descricaoNota String
  /// Nulos porque a IA devolve null quando não leu — gravar 0 ou "un" seria inventar o
  /// dado que a regra manda não inventar. Confirmar o recibo exige preencher.
  quantidade    Decimal?        @db.Decimal(12, 3)
  unidade       String?
  valorUnitCentavos  Int?
  valorTotalCentavos Int?
  tipo          ReciboItemTipo?
  /// Só pra NAO_ESTOCAVEL: em qual categoria o `Custo` é lançado. A IA sugere, o Gabriel
  /// confirma na revisão.
  categoriaCusto CategoriaCusto?
  filamentoId   String?
  filamento     Filamento?      @relation(fields: [filamentoId], references: [id])
  insumoId      String?
  insumo        Insumo?         @relation(fields: [insumoId], references: [id])
  /// Só pra FILAMENTO: total em gramas que entra no estoque (2 rolos de 1kg = 2000).
  /// Nulo quando a nota não diz o peso do rolo — aí o Gabriel completa antes de confirmar.
  gramasTotal   Int?
  /// O que a IA não leu NESTE item ("valorUnitario", "quantidade"). Mesmo papel do
  /// `camposIlegiveis` do recibo, no nível da linha.
  camposIlegiveis String[]
  /// Espelha o `consumoRegistrado` do JobProducao: marca que o movimento de estoque desta
  /// linha já foi lançado, pra reconfirmar o recibo não duplicar saldo.
  movimentoRegistrado Boolean   @default(false)
  criadoEm      DateTime        @default(now())

  @@index([reciboId])
  @@index([filamentoId])
  @@index([insumoId])
}

/// Arquivo anexado a um Recibo (imagem ou PDF). `arquivo` é path relativo a STORAGE_DIR.
model ReciboArquivo {
  id           String   @id @default(cuid())
  reciboId     String
  recibo       Recibo   @relation(fields: [reciboId], references: [id], onDelete: Cascade)
  arquivo      String
  nomeOriginal String
  mimeType     String
  bytes        Int
  criadoEm     DateTime @default(now())

  @@index([reciboId])
}

/// Modelo 3D prospectado no MakerWorld pelo bot `scripts/makerworld`.
///
/// Separado de `ProdutoOportunidade` de propósito: oportunidade é um anúncio de
/// marketplace (tem preço praticado e vendas observadas); aqui é um ARQUIVO — não tem
/// preço nem vendas, tem licença, peso e tempo de impressão. Juntar os dois obrigaria
/// metade dos campos a ficar null nos dois sentidos.
///
/// Vira Produto pelo mesmo fluxo da oportunidade: `produtoId` preenchido = já entrou no
/// catálogo.
model ModeloMakerWorld {
  id String @id @default(cuid())

  /// ID numérico do modelo no MakerWorld. String pra não depender do tipo deles.
  externalId String @unique
  titulo     String
  url        String
  autor      String
  imagemUrl  String

  downloads Int @default(0)
  curtidas  Int @default(0)
  colecoes  Int @default(0)

  /// String crua da licença ("CC0", "BY-NC-SA", "Standard Digital File License"...).
  licenca          String
  /// Veredicto comercial derivado: LIVRE / ATRIBUICAO / SEM_DERIVADAS / PROIBIDA.
  /// Só entram no banco os vendáveis — PROIBIDA aqui indicaria reclassificação posterior.
  licencaVeredicto String
  /// O que precisa ser feito pra ficar em conformidade (creditar autor, não modificar).
  licencaObrigacao String

  /// Chave do nicho comercial (FLEXI_ARTICULADO, ORGANIZACAO_SETUP, ...) definida pela IA.
  nicho String

  /// Peso e tempo DO ANÚNCIO (peça × unidadesPorKit), não da peça isolada.
  pesoGramas     Decimal @db.Decimal(10, 2)
  tempoHoras     Decimal @db.Decimal(10, 2)
  /// Quantas peças o anúncio vende junto. 1 = avulsa. Peça abaixo de 18g não se
  /// sustenta como anúncio próprio na Shopee (taxa fixa + frete), então vira kit.
  unidadesPorKit Int     @default(1)

  /// Estimativas de triagem, recalculadas pelo `packages/pricing` quando virar Produto.
  custoEstimadoCentavos Int
  precoSugeridoCentavos Int
  margemEstimadaPct     Decimal @db.Decimal(5, 2)
  /// Reais por hora de impressora — métrica de priorização da fila de produção.
  lucroPorHoraCentavos  Int

  /// 0..100 por regra (tração + rendimento + peso do nicho). Não é a nota da IA.
  scoreObjetivo   Int
  /// 0..100 dado pela avaliação visual. Curadoria do Opus sobrescreve a triagem do Haiku.
  notaIa          Int
  /// APROVADO / TALVEZ / REPROVADO
  veredictoIa     String
  justificativaIa String
  /// IP_TERCEIRO, PRECISA_SUPORTE, FRAGIL, MUITO_GENERICO, MULTICOR, SO_RENDER...
  alertas         String[]
  tags            String[]
  temFotoReal     Boolean  @default(false)

  /// Revisão do Gabriel — é a palavra final, sobrepõe o veredicto da IA.
  status     ModeloMakerWorldStatus @default(NOVO)
  observacao String?

  produtoId String?  @unique
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  anuncios AnuncioModelo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, notaIa(sort: Desc)])
  @@index([nicho, notaIa(sort: Desc)])
  @@index([lucroPorHoraCentavos(sort: Desc)])
}

enum ModeloMakerWorldStatus {
  NOVO
  FAVORITO
  DESCARTADO
  VIROU_PRODUTO
}

/// Copy de anúncio gerada pela skill `gerar-descricao` pra um modelo da prospecção.
///
/// Fica pendurada no ModeloMakerWorld, e não no Produto, porque o modelo ainda não é
/// produto: o anúncio pronto é justamente o que ajuda a decidir SE vale cadastrar.
/// Uma linha por marketplace — cada algoritmo quer título e estrutura diferentes, então
/// não dá pra guardar um texto só e reaproveitar.
///
/// A copy é gerada fora do Hub (o backend não fala com LLM nenhum): uma sessão do Claude
/// roda a skill e grava aqui via POST. Por isso `geradoEm` importa — é o que denuncia
/// anúncio velho depois que o custo ou o preço do modelo mudou.
model AnuncioModelo {
  id String @id @default(cuid())

  modeloId String
  modelo   ModeloMakerWorld @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  marketplace Canal

  titulo    String
  descricao String
  tags      String[]

  /// Caminho completo da categoria no marketplace. Cada um tem taxonomia própria — o
  /// mesmo polvo é "Brinquedos > Brinquedos Educativos e Sensoriais" na Shopee e
  /// "Brinquedos e Hobbies > Anti-stress e Engenho > Fidget Cubes" no ML.
  categoria String?

  /// ID da categoria no marketplace (ex.: MLB433037). É o que o ML usa de verdade —
  /// nome bate mal e caminho escrito de cabeça costuma não existir na árvore real.
  /// Preenchido a partir da API do próprio marketplace, nunca inventado.
  categoriaId String?

  /// Ficha técnica (atributos), como lista de {chave, valor}. Na prática é do ML:
  /// lá preencher todos os atributos é SEO crítico, e Shopee/TikTok não têm equivalente.
  /// Json porque o conjunto de campos muda por categoria do marketplace; a forma é
  /// validada na borda com Zod, não aqui.
  fichaTecnica Json?

  /// Preço que a copy assumiu quando foi escrita. Guardado separado do preço sugerido
  /// do modelo porque a descrição pode citar valor, e o sugerido muda quando o custo
  /// é recalculado — comparar os dois é o que mostra que a copy envelheceu.
  precoBaseCentavos Int

  /// Sobe a cada regeração do mesmo marketplace.
  versao Int @default(1)

  geradoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([modeloId, marketplace])
}

/// Pedido importado de um marketplace (Shopee Open Platform ou Mercado Livre).
///
/// NÃO existe "aceitar pedido" em nenhum dos dois: pedido pago já entra pronto pra
/// despachar. A única recusa possível é cancelar, e cancelar por falta de estoque
/// penaliza a reputação da loja — por isso o Hub nunca cancela automaticamente.
/// O que ele faz é atender: baixa do estoque de prontos quando há peça, ou põe na
/// fila de produção quando não há.
model PedidoMarketplace {
  id String @id @default(cuid())

  canal         Canal
  /// `order_sn` na Shopee, `id` no Mercado Livre.
  externalId    String
  /// Status cru do marketplace (READY_TO_SHIP, paid, cancelled...). Guardado sem
  /// normalizar de propósito: cada marketplace tem seu vocabulário e traduzir cedo
  /// perde informação que ajuda a depurar divergência.
  statusExterno String

  compradorNome String?
  totalCentavos Int
  /// Prazo de despacho do marketplace. É o que decide a prioridade na fila —
  /// estourar isso é penalidade na reputação.
  prazoEnvio    DateTime?
  dataPedido    DateTime

  status     PedidoStatus @default(PENDENTE)
  /// Preenchido quando algum item não pôde ser atendido (SKU sem vínculo, por exemplo).
  observacao String?

  itens        PedidoItem[]
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@unique([canal, externalId])
  @@index([status, prazoEnvio])
  @@index([dataPedido(sort: Desc)])
}

/// Item de um pedido. `variacaoId` só é preenchido quando o SKU do marketplace
/// casou com um SKU do catálogo — quando não casa, o item fica SEM_VINCULO
/// esperando o humano ligar os dois. Nunca adivinhamos por semelhança de nome:
/// errar o vínculo baixa estoque do produto errado.
model PedidoItem {
  id       String            @id @default(cuid())
  pedidoId String
  pedido   PedidoMarketplace @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  /// SKU exatamente como o marketplace enviou.
  skuExterno            String
  nomeExterno           String
  qtd                   Int
  precoUnitarioCentavos Int

  variacaoId String?
  variacao   ProdutoVariacao? @relation(fields: [variacaoId], references: [id], onDelete: SetNull)

  atendimento   PedidoItemAtendimento @default(SEM_VINCULO)
  /// Job criado quando não havia peça pronta. Permite acompanhar da venda até a impressora.
  jobProducaoId String?
  jobProducao   JobProducao?          @relation(fields: [jobProducaoId], references: [id], onDelete: SetNull)
  /// Venda gerada por este item. Existe só depois que o item foi atendido.
  venda         Venda?

  criadoEm DateTime @default(now())

  @@index([pedidoId])
  @@index([atendimento])
}

enum PedidoStatus {
  /// Chegou, ainda não processado.
  PENDENTE
  /// Todos os itens atendidos (estoque baixado ou job criado).
  ATENDIDO
  /// Pelo menos um item sem vínculo de SKU — exige ação humana.
  BLOQUEADO
  /// Cancelado no marketplace.
  CANCELADO
  ENVIADO
}

enum PedidoItemAtendimento {
  /// SKU do marketplace não casou com nenhuma variação do catálogo.
  SEM_VINCULO
  /// Havia peça pronta; estoque baixado.
  BAIXADO_ESTOQUE
  /// Não havia peça pronta; job criado na fila de produção.
  EM_PRODUCAO
}
