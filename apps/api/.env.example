NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://mahou:mahou_dev@localhost:5432/mahou_hub?schema=public"
JWT_SECRET="troque-em-producao-com-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3001"
# Em prod, defina pra `.mahouprints.com` (com o ponto na frente) pra que o cookie
# `mahou_token` seja compartilhado entre hub e api subdomains. Deixe vazio em dev.
# COOKIE_DOMAIN=.mahouprints.com
ADMIN_EMAIL="mahouprints@gmail.com"
ADMIN_INITIAL_PASSWORD="troque-no-primeiro-login"
# Credenciais da Shopee Affiliate Open Platform. Obtidas em affiliate.shopee.com.br/admin.
# Em prod, defina em /opt/mahou-hub/infra/.env.prod na VPS.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_ENDPOINT="https://open-api.affiliate.shopee.com.br/graphql"
# Leitura automática da nota anexada ao recibo. Key gratuita em aistudio.google.com/apikey
# (free tier: 1.000 leituras/dia). Sem ela, o botão "Ler nota com IA" responde 503 e o
# recibo continua funcionando no preenchimento manual.
GEMINI_API_KEY=
# Só mexa se o Google renomear o modelo ou se a cota do Flash-Lite não bastar.
GEMINI_MODEL="gemini-3.5-flash-lite"
